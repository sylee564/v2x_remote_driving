<launch>
  <!-- 공용 매니저 -->
  <node pkg="nodelet" type="nodelet" name="cam_mgr" args="manager" output="screen"/>

  <!-- 1) 캡처: gscam nodelet (예시; 실제 gscam nodelet 이름/args는 환경에 맞춰 조정) -->
  <node pkg="nodelet" type="nodelet" name="front_gscam"
        args="load gscam/GSCamNodelet cam_mgr" output="screen">
    <param name="frame_id" value="front_optical"/>
    <param name="use_gst_timestamps" value="true"/>
    <param name="gscam_config" value="
      v4l2src device=/dev/video0 !
      video/x-raw,format=UYVY,width=1280,height=720,framerate=30/1 !
      videoconvert !
      appsink name=appsink caps=video/x-raw,format=BGR drop=true max-buffers=2 sync=false
    "/>
    <remap from="image_raw"   to="/front/image_raw"/>
    <remap from="camera_info" to="/front/camera_info"/>
  </node>

  <node pkg="nodelet" type="nodelet" name="rear_gscam"
        args="load gscam/GSCamNodelet cam_mgr" output="screen">
    <param name="frame_id" value="rear_optical"/>
    <param name="use_gst_timestamps" value="true"/>
    <param name="gscam_config" value="
      v4l2src device=/dev/video0 !
      video/x-raw,format=UYVY,width=1280,height=720,framerate=30/1 !
      videoconvert !
      appsink name=appsink caps=video/x-raw,format=BGR drop=true max-buffers=2 sync=false
    "/>
    <remap from="image_raw"   to="/rear/image_raw"/>
    <remap from="camera_info" to="/rear/camera_info"/>
  </node>

  <!-- 2) 전처리: image_proc nodelet -->
  <node pkg="nodelet" type="nodelet" name="front_proc"
        args="load image_proc/image_proc cam_mgr" output="screen" ns="front">
    <remap from="image"       to="/front/image_raw"/>
    <remap from="camera_info" to="/front/camera_info"/>
    <remap from="image_rect_color" to="/front/image_rect_color"/>
  </node>

  <!-- 3) 인코더: h26x_encoder nodelet -->
  <node pkg="nodelet" type="nodelet" name="front_encoder"
        args="load h26x_encoder/H26xEncoderNodelet cam_mgr" output="screen">
    <param name="input_topic"       value="/front/image_rect_color"/>
    <param name="camera_info_topic" value="/front/camera_info"/>

    <param name="codec"        value="h264"/>         <!-- or h265 -->
    <param name="mode"         value="auto"/>         <!-- auto|cpu|hw -->
    <param name="bitrate_bps"  value="2500000"/>
    <param name="gop"          value="30"/>
    <param name="fps_hint"     value="30"/>
    <param name="fps_mode"     value="nominal"/>      <!-- EncodedFrame은 30/1 고정 -->
    <param name="fps_nominal"  value="30"/>
    <param name="stream_id"    value="0"/>
  </node>
</launch>
