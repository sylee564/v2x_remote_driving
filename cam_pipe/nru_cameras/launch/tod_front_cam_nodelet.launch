<launch>
  <!-- 공통 인자 -->
  <arg name="front_ns"   default="front"/>
  <arg name="rear_ns"    default="rear"/>
  <arg name="device_front" default="/dev/video0"/>
  <arg name="device_rear"  default="/dev/video3"/>
  <arg name="width"    default="1280"/>
  <arg name="height"   default="720"/>
  <arg name="fps"      default="30/1"/>
  <arg name="format"   default="UYVY"/>
  <arg name="stream_id"   default="0"/>

  <!-- PiP (front만 사용) -->
  <arg name="pip_enable"    default="true"/>
  <arg name="pip_topic"     default="/rear/camera/image_rect"/>
  <arg name="parking_topic" default="/rear_wide/camera/image_rect"/> 

  <arg name="pip_scale_w"   default="0.5"/>
  <arg name="pip_scale_h"   default="0.2"/>
  <arg name="pip_margin"    default="0"/>
  <arg name="pip_alpha"     default="0.9"/>
  <arg name="bg_dim_alpha"  default="0.18"/>
  <arg name="draw_border"   default="true"/>
  <arg name="border_px"     default="2"/>
  <arg name="pip_position"  default="top_center"/>

  <!-- 제어 토픽 -->
  <arg name="control_topic" default="/Vehicle/Control/control_cmd_data"/>

  <!-- Nodelet 매니저(루트 네임스페이스) -->


  <!-- Front 카메라 -->
  <group ns="$(arg front_ns)">

    <node pkg="nodelet" type="nodelet" name="$(arg front_ns)_gscam_pip_manager" args="manager" output="screen">
      <param name="num_worker_threads" value="8"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="$(arg front_ns)_cam"
          args="load gscam_cuda_pip/GscamCudaPipNodelet $(arg front_ns)_gscam_pip_manager"
          output="screen">
      <param name="ns"     value="$(arg front_ns)"/>

      <!-- 카메라/프레임 -->
      <param name="camera_info_url" value="file://$(find nru_cameras)/config/$(arg front_ns).yaml"/>
      <param name="camera_name"     value="$(arg front_ns)"/>
      <param name="frame_id"        value="$(arg front_ns)_frame"/>
      <param name="image_encoding"  value="rgb8"/>
      <param name="use_rectify"     value="true"/>

      <!-- GStreamer: 한 줄! -->
      <param name="gscam_config"
             value="nvv4l2camerasrc device=$(arg device_front) ! video/x-raw(memory:NVMM),width=$(arg width),height=$(arg height),framerate=$(arg fps),format=$(arg format) ! nvvidconv ! video/x-raw,format=BGRx,width=$(arg width),height=$(arg height) ! videoconvert n-threads=2 ! video/x-raw,format=BGR ! queue leaky=downstream max-size-buffers=2 max-size-time=0 max-size-bytes=0"/>

      <param name="sync_sink"          value="true"/>
      <param name="preroll"            value="false"/>
      <param name="use_gst_timestamps" value="true"/>
      <param name="reopen_on_eof"      value="false"/>

      <!-- PiP -->
      <param name="pip_enable"     value="$(arg pip_enable)"/>
      <param name="pip_topic"      value="$(arg pip_topic)"/>
      <param name="pip_scale_w"    value="$(arg pip_scale_w)"/>
      <param name="pip_scale_h"    value="$(arg pip_scale_h)"/>
      <param name="pip_margin"     value="$(arg pip_margin)"/>
      <param name="pip_alpha"      value="$(arg pip_alpha)"/>
      <param name="bg_dim_alpha"   value="$(arg bg_dim_alpha)"/>
      <param name="draw_border"    value="$(arg draw_border)"/>
      <param name="border_px"      value="$(arg border_px)"/>
      <param name="pip_position"   value="$(arg pip_position)"/>

      <!-- 토픽 remap -->
      <remap from="image_raw"     to="camera/image_raw"/>
      <remap from="image_rect"    to="camera/image_rect"/>
      <remap from="image_overlay" to="camera/image_overlay"/>
      <remap from="control_cmd"   to="$(arg control_topic)"/>
    </node>

    <!-- Front 인코더 (필요 없으면 주석) -->
    <node pkg="nodelet" type="nodelet" name="encoder"
          args="load h26x_encoder/H26xEncoderNodelet $(arg front_ns)_gscam_pip_manager" output="screen">
      <param name="input_topic"       value="camera/image_overlay"/>
      <param name="camera_info_topic" value="camera/camera_info"/>
      <param name="codec"        value="h264"/>
      <param name="mode"         value="auto"/>
      <param name="bitrate_bps"  value="2500000"/>
      <param name="gop"          value="30"/>
      <param name="fps_hint"     value="30"/>
      <param name="fps_mode"     value="nominal"/>
      <param name="fps_nominal"  value="30"/>
      <param name="stream_id"  value="$(arg stream_id)"/>
    </node>
  </group>

  <!-- Rear 카메라 -->
  <!-- <group ns="$(arg rear_ns)">
    <node pkg="nodelet" type="nodelet" name="rear_cam"
          args="load gscam_cuda_pip/GscamCudaPipNodelet /gscam_pip_manager"
          output="screen">
      <param name="ns"     value="$(arg rear_ns)"/>

      <param name="camera_info_url" value="file://$(find nru_cameras)/config/$(arg rear_ns).yaml"/>
      <param name="camera_name"     value="$(arg rear_ns)"/>
      <param name="frame_id"        value="$(arg rear_ns)_frame"/>
      <param name="image_encoding"  value="rgb8"/>
      <param name="use_rectify"     value="true"/>

      <param name="gscam_config"
             value="nvv4l2camerasrc device=$(arg device_rear) ! video/x-raw(memory:NVMM),width=$(arg width),height=$(arg height),framerate=$(arg fps),format=$(arg format) ! nvvidconv ! video/x-raw,format=BGRx,width=$(arg width),height=$(arg height) ! videoconvert n-threads=2 ! video/x-raw,format=BGR ! queue leaky=downstream max-size-buffers=2 max-size-time=0 max-size-bytes=0"/>

      <param name="sync_sink"          value="true"/>
      <param name="preroll"            value="false"/>
      <param name="use_gst_timestamps" value="true"/>
      <param name="reopen_on_eof"      value="false"/>

      <param name="pip_enable" value="false"/>

      <remap from="image_raw"     to="camera/image_raw"/>
      <remap from="image_rect"    to="camera/image_rect"/>
      <remap from="image_overlay" to="camera/image_overlay"/>
      <remap from="control_cmd"   to="$(arg control_topic)"/>
    </node>
  </group> -->
</launch>
