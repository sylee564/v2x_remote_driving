<launch>
  <!-- 인자 -->
  <arg name="ns"         default="front"/>
  <arg name="device"     default="/dev/video0"/>
  <arg name="format"     default="UYVY"/>
  <arg name="width"      default="1280"/>
  <arg name="height"     default="720"/>
  <arg name="fps"        default="30/1"/>
  <arg name="frame_id"   default="$(arg ns)_frame"/>
  <arg name="camera_info" default="$(find nru_cameras)/config/$(arg ns).yaml"/>

  <!-- Nodelet 매니저 -->
  <group ns="$(arg ns)">
    <node pkg="nodelet" type="nodelet" name="$(arg ns)_manager" args="manager" output="screen"/>

    <!-- gscam Nodelet -->
    <node pkg="nodelet" type="nodelet" name="$(arg ns)_cam"
          args="load gscam/GSCamNodelet $(arg ns)_manager" output="screen">

      <param name="camera_name" value="$(arg ns)"/>
      <param name="camera_info_url" value="file://$(arg camera_info)"/>
      <param name="frame_id" value="$(arg frame_id)"/>

      <param name="use_gst_timestamps" value="true"/>
      <param name="sync_sink" value="true"/>
      <param name="preroll" value="false"/>
      <param name="image_encoding" value="rgb8"/>

      <param name="gscam_config" value="nvv4l2camerasrc device=$(arg device) !
                    video/x-raw(memory:NVMM),width=$(arg width),height=$(arg height),framerate=$(arg fps),format=$(arg format) !
                    nvvidconv ! videoconvert"/>
    </node>

    <!-- 필요 시 보정/rectify를 같은 매니저에 로드 -->
    <!-- <node pkg="nodelet" type="nodelet" name="$(arg ns)_image_proc" args="load image_proc/image_proc $(arg ns)_manager" ns="$(arg ns)"/> -->
  </group>
</launch>
