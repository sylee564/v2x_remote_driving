<launch>
  <include file="$(find nru_cameras)/launch/single_camera.launch">
    <arg name="ns" value="front"/>
    <arg name="device" value="/dev/video0"/>
    <arg name="format" value="UYVY"/>
    <arg name="width" value="1280"/>
    <arg name="height" value="720"/>
    <arg name="fps" value="30/1"/>
  </include>

  <include file="$(find nru_cameras)/launch/single_camera.launch">
    <arg name="ns" value="left"/>
    <arg name="device" value="/dev/video1"/>
    <arg name="format" value="UYVY"/>
    <arg name="width" value="1280"/>
    <arg name="height" value="720"/>
    <arg name="fps" value="30/1"/>
  </include>

  <include file="$(find nru_cameras)/launch/single_camera.launch">
    <arg name="ns" value="right"/>
    <arg name="device" value="/dev/video2"/>
    <arg name="format" value="UYVY"/>
    <arg name="width" value="1280"/>
    <arg name="height" value="720"/>
    <arg name="fps" value="30/1"/>
  </include>

  <include file="$(find nru_cameras)/launch/single_camera.launch">
    <arg name="ns" value="rear"/>
    <arg name="device" value="/dev/video3"/>
    <arg name="format" value="UYVY"/>
    <arg name="width" value="1280"/>
    <arg name="height" value="720"/>
    <arg name="fps" value="30/1"/>
  </include>
</launch>
