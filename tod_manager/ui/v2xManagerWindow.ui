	padding:5px 10px;
	color:#fff;
}
#leftMenuContainer QPushButton:hover{  background-color: rgb(114, 159, 207); }
#leftMenuContainer QPushButton:focus{   background-color: rgb(114, 159, 207);}


#connectBtn{
	border:none;
	background-color:#144578;
	color:#fff;
	padding:2px 5px;
}

#connectBtn:hover{
	background-color: rgb(114, 159, 207); 
}

#pushButton_DBconfigSave{
